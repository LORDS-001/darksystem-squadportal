# DigitalOcean App Platform injects DATABASE_URL when the PostgreSQL component is bound.
DATABASE_URL=
PORT=8080
HOST=0.0.0.0
DARK_SYSTEM_DEMO_DATA=0
DARK_SYSTEM_SESSION_SECRET=replace-with-a-long-random-secret
OWNER_SETUP_SECRET=replace-with-a-separate-long-random-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
